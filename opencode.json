{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "owner",
  "instructions": ["AGENTS.md"],
  "agent": {
    "owner": {
      "description": "Orquestrador: decide o que construir, delega ao Coder, revisa resultado, coordena o Review.",
      "model": "google/antigravity-gemini-3-flash",
      "mode": "primary",
      "permissions": {
        "edit": "allow",
        "bash": "allow",
        "task": {
          "*": "deny",
          "designer": "allow",
          "coder": "allow",
          "reviewer": "allow"
        }
      }
    },
    "coder": {
      "description": "Implementa features seguindo especificação do Owner. Focado em codar, não em decisões de design.",
      "model": "google/antigravity-gemini-3-flash",
      "mode": "subagent",
      "hidden": true,
      "permissions": {
        "edit": "allow",
        "bash": "allow",
        "task": "deny"
      }
    },
    "reviewer": {
      "description": "Revisa código e UI: qualidade, acessibilidade, performance, aderência ao brief. Só lê, não edita.",
      "model": "google/antigravity-gemini-3-flash",
      "mode": "subagent",
      "hidden": true,
      "permissions": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "designer": {
      "description": "Traduz o brief do Impeccable para tokens de design (catalog.pen). Focado em UI/UX, não codifica.",
      "model": "google/antigravity-gemini-3-flash",
      "mode": "subagent",
      "hidden": true,
      "permissions": {
        "edit": "allow",
        "task": "deny"
      }
    }
  }
}
